    # Barra de progreso propia (redondeada, con el degradado de la marca).
    $bar = New-Object System.Windows.Forms.PictureBox
    $bar.SetBounds(26, 246, 488, 10)
    $bar.BackColor = [System.Drawing.Color]::White
    $bar.Visible = $false
    $bar.add_Paint({
            param($sender, $e)
            $gr = $e.Graphics
            $gr.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
            $w = [single]($sender.ClientSize.Width - 1)
            $h = [single]($sender.ClientSize.Height - 1)
            $track = New-RoundPath 0 0 $w $h ($h / 2)
            $tb = New-Object System.Drawing.SolidBrush $Ui.Track
            $gr.FillPath($tb, $track)
            $tb.Dispose()
            $fw = [single]([Math]::Max(0.0, [Math]::Min(1.0, $St.Progress)) * $w)
            if ($fw -ge $h) {
                $fill = New-RoundPath 0 0 $fw $h ($h / 2)
                $gb = New-KdGradient 0 0 ($w + 1) 0
                $gr.FillPath($gb, $fill)
                $gb.Dispose(); $fill.Dispose()
            }
            if ($St.Busy) {
                # Brillo que avanza mientras un paso no tiene progreso medible.
                $span = 90.0
                $x = (($St.Tick * 7) % ($w + $span)) - $span
                $gr.SetClip($track)
                $shine = New-Object System.Drawing.Drawing2D.LinearGradientBrush (New-Object System.Drawing.PointF $x, 0), (New-Object System.Drawing.PointF ($x + $span), 0), ([System.Drawing.Color]::FromArgb(0, 99, 102, 241)), ([System.Drawing.Color]::FromArgb(150, 139, 92, 246))
                $shine.WrapMode = [System.Drawing.Drawing2D.WrapMode]::TileFlipX
                $gr.FillRectangle($shine, $x, 0, $span, $h + 1)
                $shine.Dispose()
                $gr.ResetClip()
            }
            $track.Dispose()
        })
    $Ui.Bar = $bar
    $form.Controls.Add($bar)

    $status = New-Object System.Windows.Forms.Label
    $status.SetBounds(26, 266, 488, 24)
    $status.ForeColor = $Ui.Text
    $status.Font = $Ui.FontBold
    $Ui.Status = $status
    $form.Controls.Add($status)

    $detail = New-Object System.Windows.Forms.Label
    $detail.SetBounds(26, 290, 488, 44)
    $detail.Font = $Ui.FontSmall
    $detail.ForeColor = $Ui.Muted
    $Ui.Detail = $detail
    $form.Controls.Add($detail)

    $log = New-Object System.Windows.Forms.LinkLabel
    $log.SetBounds(26, 357, 200, 22)
    $log.Font = $Ui.FontSmall
    $log.Text = S 'Ver el registro de instalaci~on'
    $log.LinkColor = $Ui.C1
    $log.Visible = $false
    $log.add_LinkClicked({ try { Start-Process -FilePath 'notepad.exe' -ArgumentList (Quote $LogFile) } catch { } })
    $Ui.LogLink = $log
    $form.Controls.Add($log)

    $secondary = New-KdButton 'Cancelar' 236 350 116 $false
    $primary = New-KdButton 'Instalar' 362 350 152 $true
    $Ui.Primary = $primary
    $Ui.Secondary = $secondary
    $form.Controls.Add($secondary)
    $form.Controls.Add($primary)
    $form.AcceptButton = $primary

    $timer = New-Object System.Windows.Forms.Timer
    $timer.Interval = 50
    $timer.add_Tick({
            try { Invoke-KdTick } catch { Show-KdFailure $_ }
        })
    $Ui.Timer = $timer

    $primary.add_Click({
            switch ($St.Ui) {
                'done' {
                    try { Start-KdApp } catch { Write-Log ('No se pudo abrir la app: ' + $_.Exception.Message) }
                    $Ui.Form.Close()
                }
                default { Start-KdInstall }
            }
        })
    $secondary.add_Click({ $Ui.Form.Close() })

    $form.add_FormClosing({
            param($sender, $e)
            if ($St.Ui -ne 'running') { return }
            if ($St.Critical) {
                [void][System.Windows.Forms.MessageBox]::Show($Ui.Form, (S 'Espera un momento: se est~an copiando los archivos de K-Downloader.'), (S 'Instalar K-Downloader'))
                $e.Cancel = $true
                return
            }
            $answer = [System.Windows.Forms.MessageBox]::Show($Ui.Form, (S '~?Cancelar la instalaci~on?'), (S 'Instalar K-Downloader'),
                [System.Windows.Forms.MessageBoxButtons]::YesNo, [System.Windows.Forms.MessageBoxIcon]::Question)
            if ($answer -ne [System.Windows.Forms.DialogResult]::Yes -or $St.Critical) {
                $e.Cancel = $true
                return
            }
            $Ui.Timer.Stop()
            Write-Log 'Instalacion cancelada por el usuario'
            Clear-KdTemp
            $St.ExitCode = 1
        })
    $form.add_Shown({
            $Ui.Form.TopMost = $true
            $Ui.Form.Activate()
            $Ui.Form.TopMost = $false
            [void]$Ui.Primary.Focus()
        })

    Set-KdUiState 'ready'
    Set-KdStatus '' '' $false
    [void]$form.ShowDialog()
    $Ui.Timer.Stop()
    $Ui.Timer.Dispose()
    $form.Dispose()
    return $St.ExitCode
}

# --- Inicio -----------------------------------------------------------------------------------

try {
    Read-KdOptions
} catch {
    $fail = Get-KdFailure $_
    Write-Log ('ERROR de opciones: ' + $fail.Message + ' ' + $fail.Detail)
    Write-Host ('ERROR: ' + $fail.Message + ' ' + $fail.Detail)
    Show-KdHelp
    if ($Opt.Mode -eq 'ui') {
        try {
            Add-Type -AssemblyName System.Windows.Forms
            [void][System.Windows.Forms.MessageBox]::Show(($fail.Message + ' ' + $fail.Detail), (S 'Instalar K-Downloader'))
        } catch { }
    }
    exit 1
}
if ($Opt.Help) { Show-KdHelp; exit 0 }

if ($Opt.Mode -eq 'ui') {
    if ($ExecutionContext.SessionState.LanguageMode -ne 'FullLanguage') { Write-Log 'Sin FullLanguage: modo consola'; exit 3 }
    try {
        Add-Type -AssemblyName System.Windows.Forms, System.Drawing
    } catch {
        Write-Log ('Sin WinForms: ' + $_.Exception.Message)
        exit 3
    }
    exit (Show-KdWindow)
}
exit (Invoke-KdConsole)
