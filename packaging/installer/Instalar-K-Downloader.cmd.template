@echo off
rem ==========================================================================================
rem  Instalar-K-Downloader.cmd - instalador de K-Downloader {{VERSION}}
rem  https://kdownloader.vercel.app  -  https://github.com/Kasaco223/K-YoutubeVideoDownloaderHD
rem
rem  Que hace (puedes leerlo entero; es texto):
rem   1. Descarga {{BUNDLE_NAME}} desde GitHub Releases con curl.exe (incluido en Windows).
rem   2. Verifica su SHA-256: {{BUNDLE_SHA256}}
rem   3. Lo instala en %LOCALAPPDATA%\Programs\K-Downloader (solo tu usuario, sin administrador).
rem   4. Crea el acceso directo, registra kdownloader:// y la entrada para desinstalar.
rem  La parte de abajo de la marca __KD_INSTALLER_PS__ es PowerShell y se ejecuta desde aqui.
rem
rem  Opciones: --local ZIP  --root CARPETA  --desktop  --no-desktop  --no-registry
rem            --shortcut-dir CARPETA  --sha256 HASH  --quiet  --console  --launch  --no-launch  --help
rem ==========================================================================================
setlocal DisableDelayedExpansion
set "KD_SELF=%~f0"
set "KD_ARGS=%*"
set "KD_MODE=ui"
for %%A in (%*) do (
  if /i "%%~A"=="--quiet" set "KD_MODE=quiet"
  if /i "%%~A"=="--console" set "KD_MODE=console"
  if /i "%%~A"=="--help" set "KD_MODE=console"
)
set "KD_HIDE="
if "%KD_MODE%"=="ui" set "KD_HIDE=-WindowStyle Hidden"
rem  Abierto desde PowerShell 7, PSModulePath trae sus modulos y Windows PowerShell 5.1 no encuentra
rem  los suyos (Get-FileHash, etc.). Vacio, 5.1 usa su ruta por defecto.
set "PSModulePath="
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile %KD_HIDE% -Command "$f=[IO.File]::ReadAllText($env:KD_SELF);$m='#__KD_INSTALLER'+'_PS__';$i=$f.IndexOf($m);if($i -lt 0){exit 1};. ([ScriptBlock]::Create($f.Substring($i)))"
set "KD_RC=%ERRORLEVEL%"
if "%KD_RC%"=="3" if "%KD_MODE%"=="ui" goto kd_console
if "%KD_MODE%"=="console" pause
exit /b %KD_RC%
:kd_console
start "Instalar K-Downloader" "%ComSpec%" /c ""%~f0" --console %*"
exit /b 0
#__KD_INSTALLER_PS__
# ===========================================================================================
# Instalador de K-Downloader (Windows PowerShell 5.1). Se ejecuta desde el .cmd de arriba.
# Este archivo debe ser ASCII puro: los acentos del texto en pantalla salen de la funcion S
# (~a ~e ~i ~o ~u = vocales con tilde, ~n = enie, ~? y ~! = signos de apertura, ~. = puntos
# suspensivos, ~* = punto medio).
# Codigos de salida: 0 instalado, 1 error o cancelado, 3 sin interfaz grafica (el .cmd reintenta
# en modo consola).
# ===========================================================================================
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$KD = @{
    Version = '{{VERSION}}'
    Url     = '{{BUNDLE_URL}}'
    Sha256  = '{{BUNDLE_SHA256}}'
    Name    = '{{BUNDLE_NAME}}'
    Size    = '{{BUNDLE_SIZE}}'
    App     = 'K-Downloader'
    Web     = 'https://kdownloader.vercel.app'
}

# --- Texto ----------------------------------------------------------------------------------

$KdChars = New-Object 'System.Collections.Generic.Dictionary[string,string]' ([StringComparer]::Ordinal)
foreach ($pair in @(
        @('a', 0xE1), @('e', 0xE9), @('i', 0xED), @('o', 0xF3), @('u', 0xFA), @('n', 0xF1),
        @('A', 0xC1), @('E', 0xC9), @('I', 0xCD), @('O', 0xD3), @('U', 0xDA), @('N', 0xD1),
        @('?', 0xBF), @('!', 0xA1), @('.', 0x2026), @('*', 0xB7))) {
    $KdChars[$pair[0]] = [string][char]$pair[1]
}

function S([string]$Text) {
    $sb = New-Object System.Text.StringBuilder
    for ($i = 0; $i -lt $Text.Length; $i++) {
        $c = [string]$Text[$i]
        if ($c -eq '~' -and ($i + 1) -lt $Text.Length -and $KdChars.ContainsKey([string]$Text[$i + 1])) {
            [void]$sb.Append($KdChars[[string]$Text[$i + 1]])
            $i++
        } else {
            [void]$sb.Append($c)
        }
    }
    return $sb.ToString()
}

$LogFile = Join-Path ([IO.Path]::GetTempPath()) 'K-Downloader-instalacion.log'

function Write-Log([string]$Message) {
    try {
        $line = '{0:yyyy-MM-dd HH:mm:ss} {1}{2}' -f (Get-Date), $Message, [Environment]::NewLine
        [IO.File]::AppendAllText($LogFile, $line, [Text.Encoding]::UTF8)
    } catch { }
}

function New-KdError([string]$Message, [string]$Detail) {
    $e = New-Object System.Exception $Message
    $e.Data['kd'] = $true
    if ($Detail) { $e.Data['detail'] = $Detail }
    return $e
}

function Quote([string]$Path) {
    $p = $Path
    if ($p.Length -gt 3) { $p = $p.TrimEnd('\') }
    return '"' + $p + '"'
}

# --- Opciones -------------------------------------------------------------------------------

function Split-KdArgs([string]$Line) {
    $list = New-Object System.Collections.Generic.List[string]
    if ($Line) {
        foreach ($m in [regex]::Matches($Line, '"([^"]*)"|(\S+)')) {
            if ($m.Groups[1].Success) { $list.Add($m.Groups[1].Value) } else { $list.Add($m.Groups[2].Value) }
        }
    }
    return , $list
}

$Opt = @{
    Local = $null; Root = $null; ExplicitRoot = $false; NoRegistry = $false; Mode = 'ui'
    Desktop = $null; ShortcutDir = $null; Sha256 = $KD.Sha256; Launch = $null; Help = $false
}
$St = @{
    Root = $null; Existing = $null; Index = 0; Waiter = $null; Ui = 'ready'; Critical = $false
    Zip = $null; Downloaded = $false; TempDir = $null; Staging = $null; Desktop = $false
    Curl = $null; CurlExtra = ''; Tar = $null; UseTar = $true; Progress = 0.0; Busy = $false
    Tick = 0; ExitCode = 1; StepBase = 0.0
}

function Read-KdOptions {
    $argv = Split-KdArgs $env:KD_ARGS
    # El modo se decide antes que nada: un error en otra opcion no debe abrir ventanas con --quiet.
    foreach ($a in $argv) {
        if ($a -ieq '--quiet') { $Opt.Mode = 'quiet' }
        elseif ($a -ieq '--console' -and $Opt.Mode -ne 'quiet') { $Opt.Mode = 'console' }
    }
    for ($i = 0; $i -lt $argv.Count; $i++) {
        $a = $argv[$i]
        $needsValue = @('--local', '--root', '--shortcut-dir', '--sha256') -contains $a.ToLowerInvariant()
        $value = $null
        if ($needsValue) {
            if ($i + 1 -ge $argv.Count) { throw (New-KdError ((S 'Falta el valor de la opci~on ') + $a) '') }
            $i++
            $value = $argv[$i]
        }
        switch ($a.ToLowerInvariant()) {
            '--local' { $Opt.Local = [IO.Path]::GetFullPath($value) }
            '--root' { $Opt.Root = [IO.Path]::GetFullPath($value); $Opt.ExplicitRoot = $true }
            '--shortcut-dir' { $Opt.ShortcutDir = [IO.Path]::GetFullPath($value) }
            '--sha256' { $Opt.Sha256 = $value.Trim().ToLowerInvariant() }
            '--no-registry' { $Opt.NoRegistry = $true }
            '--desktop' { $Opt.Desktop = $true }
            '--no-desktop' { $Opt.Desktop = $false }
            '--quiet' { $Opt.Mode = 'quiet' }
            '--console' { if ($Opt.Mode -ne 'quiet') { $Opt.Mode = 'console' } }
            '--launch' { $Opt.Launch = $true }
            '--no-launch' { $Opt.Launch = $false }
            { $_ -in @('--help', '-h') } { $Opt.Help = $true }
            default { throw (New-KdError ((S 'Opci~on desconocida: ') + $a) '') }
        }
    }
    if ($Opt.Sha256 -notmatch '^[0-9a-fA-F]{64}$') { throw (New-KdError (S 'El hash SHA-256 no es v~alido.') $Opt.Sha256) }
    if ($Opt.Root) {
        $St.Root = $Opt.Root
    } else {
        $St.Root = Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'Programs\K-Downloader'
    }
    $St.Root = $St.Root.TrimEnd('\')
    $cur = Join-Path $St.Root 'current'
    if (Test-Path -LiteralPath $cur -PathType Leaf) {
        try { $St.Existing = ([IO.File]::ReadAllText($cur)).Trim() } catch { }
    }
}

function Show-KdHelp {
    Write-Host ''
    Write-Host ((S 'Instalador de K-Downloader ') + $KD.Version)
    Write-Host ''
    Write-Host '  Instalar-K-Downloader.cmd [opciones]'
    Write-Host ''
    Write-Host ((S '  --local <zip>          usa un paquete local en vez de descargarlo'))
    Write-Host ((S '  --sha256 <hash>        SHA-256 esperado del paquete (por defecto, el de esta versi~on)'))
    Write-Host ((S '  --root <carpeta>       instala en otra carpeta (pruebas)'))
    Write-Host ((S '  --no-registry          no toca el registro ni crea accesos directos (pruebas)'))
    Write-Host ((S '  --shortcut-dir <dir>   crea el acceso directo del men~u Inicio en esa carpeta'))
    Write-Host ((S '  --desktop/--no-desktop crea (o no) el acceso directo en el escritorio'))
    Write-Host ((S '  --quiet                sin ventanas ni preguntas (CI); no abre la app salvo --launch'))
    Write-Host ((S '  --console              muestra el progreso en la consola en vez de la ventana'))
    Write-Host ((S '  --launch/--no-launch   abre (o no) K-Downloader al terminar'))
    Write-Host ''
}

# --- Utilidades de archivos y procesos ------------------------------------------------------

function Test-Within([string]$Child, [string]$Parent) {
    $c = [IO.Path]::GetFullPath($Child).TrimEnd('\')
    $p = [IO.Path]::GetFullPath($Parent).TrimEnd('\')
    return ($c -ieq $p) -or $c.StartsWith($p + '\', [StringComparison]::OrdinalIgnoreCase)
}

function Test-Reparse([string]$Path) {
    try {
        $item = Get-Item -LiteralPath $Path -Force
        return [bool]($item.Attributes -band [IO.FileAttributes]::ReparsePoint)
    } catch {
        return $false
    }
}

function Remove-KdDir([string]$Path) {
    # .NET Framework no sigue uniones (junctions) ni enlaces al borrar: quita solo el enlace.
    if (-not $Path -or -not (Test-Path -LiteralPath $Path)) { return }
    try {
        if (Test-Reparse $Path) { [IO.Directory]::Delete($Path, $false) } else { [IO.Directory]::Delete($Path, $true) }
    } catch {
        Write-Log ('No se pudo borrar ' + $Path + ': ' + $_.Exception.Message)
    }
}

function Move-KdDir([string]$From, [string]$To) {
    for ($i = 0; $i -lt 10; $i++) {
        try {
            [IO.Directory]::Move($From, $To)
            return
        } catch {
            if ($i -eq 9) { throw }
            Start-Sleep -Milliseconds 500
        }
    }
}

function New-KdId { return [Guid]::NewGuid().ToString('N').Substring(0, 8) }

function Start-KdProcess([string]$File, [string]$Arguments) {
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $File
    $psi.Arguments = $Arguments
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $true
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $psi.StandardOutputEncoding = [Text.Encoding]::UTF8
    $psi.StandardErrorEncoding = [Text.Encoding]::UTF8
    $psi.EnvironmentVariables['PYTHONIOENCODING'] = 'utf-8'
    $psi.EnvironmentVariables['PYTHONUTF8'] = '1'
    Write-Log ('> ' + $File + ' ' + $Arguments)
    $p = [Diagnostics.Process]::Start($psi)
    return @{
        Proc = $p; Out = $p.StandardOutput.ReadToEndAsync(); Err = $p.StandardError.ReadToEndAsync()
        Progress = $null; Detail = $null; Done = $null
    }
}

function Stop-KdWaiter {
    $w = $St.Waiter
    $St.Waiter = $null
    if ($w -and $w.Proc -and -not $w.Proc.HasExited) {
        try { $w.Proc.Kill(); [void]$w.Proc.WaitForExit(5000) } catch { }
    }
}

function Clear-KdTemp {
    Stop-KdWaiter
    if ($St.Staging) { Remove-KdDir $St.Staging; $St.Staging = $null }
    if ($St.TempDir) { Remove-KdDir $St.TempDir; $St.TempDir = $null }
}

function Get-KdRunning {
    $rt = Join-Path $St.Root 'runtime'
    return @(Get-Process -Name 'python', 'pythonw' -ErrorAction SilentlyContinue | Where-Object {
            $path = $null
            try { $path = $_.Path } catch { }
            $path -and (Test-Within $path $rt)
        })
}

function Get-DesktopLink { return Join-Path ([Environment]::GetFolderPath('Desktop')) 'K-Downloader.lnk' }

function Confirm-Kd([string]$Message) {
    if ($Opt.Mode -eq 'quiet') { return $true }
    if ($Opt.Mode -eq 'console') {
        $answer = Read-Host ($Message + ' (S/N)')
        return $answer -match '^\s*[sSyY]'
    }
    $r = [System.Windows.Forms.MessageBox]::Show($Ui.Form, $Message, (S 'Instalar K-Downloader'),
        [System.Windows.Forms.MessageBoxButtons]::YesNo, [System.Windows.Forms.MessageBoxIcon]::Question)
    return $r -eq [System.Windows.Forms.DialogResult]::Yes
}

function Test-KdElevated {
    try {
        $p = New-Object Security.Principal.WindowsPrincipal ([Security.Principal.WindowsIdentity]::GetCurrent())
        return $p.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    } catch {
        return $false
    }
}

function Get-KdShellUsers {
    # Cuentas duenas de explorer.exe en esta sesion: la persona que esta frente a la PC.
    $session = [Diagnostics.Process]::GetCurrentProcess().SessionId
    $users = @()
    try {
        foreach ($p in @(Get-CimInstance Win32_Process -Filter "Name = 'explorer.exe'" -ErrorAction Stop)) {
            if ($p.SessionId -ne $session) { continue }
            $o = Invoke-CimMethod -InputObject $p -MethodName GetOwner -ErrorAction Stop
            if ($o.ReturnValue -eq 0 -and $o.User) { $users += ($o.Domain + '\' + $o.User) }
        }
    } catch {
        Write-Log ('No se pudo saber quien usa la sesion: ' + $_.Exception.Message)
    }
    return $users
}

function Start-KdApp {
    $pyw = Join-Path $St.Root 'runtime\pythonw.exe'
    if (Test-KdElevated) {
        # Con "Ejecutar como administrador" la app no debe quedar elevada: no recibiria enlaces arrastrados y
        # una segunda ventana normal no podria hablarle. explorer.exe abre el acceso directo con los permisos
        # normales de la sesion.
        $dir = $Opt.ShortcutDir
        if (-not $dir) { $dir = [Environment]::GetFolderPath('Programs') }
        $lnk = Join-Path $dir 'K-Downloader.lnk'
        if (Test-Path -LiteralPath $lnk -PathType Leaf) {
            Write-Log ('Instalador como administrador: abriendo ' + $lnk + ' con explorer.exe')
            Start-Process -FilePath (Join-Path $env:SystemRoot 'explorer.exe') -ArgumentList (Quote $lnk)
        } else {
            Write-Log 'Instalador como administrador y sin acceso directo: no se abre la app para no dejarla elevada'
        }
        return
    }
    Write-Log ('Abriendo ' + $pyw)
    Start-Process -FilePath $pyw -ArgumentList (Quote (Join-Path $St.Root 'launch.pyw')) -WorkingDirectory $St.Root
}

# --- Pasos ----------------------------------------------------------------------------------
# Cada paso termina en el acto (devuelve $null) o devuelve un "waiter" con un proceso en curso;
# asi la ventana sigue respondiendo mientras curl o tar trabajan.

function Invoke-StepCheck {
    $v = [Environment]::OSVersion.Version
    if ($v.Major -lt 10) { throw (New-KdError (S 'K-Downloader necesita Windows 10 u 11.') ('Windows ' + $v)) }
    if (-not [Environment]::Is64BitOperatingSystem) { throw (New-KdError (S 'K-Downloader necesita Windows de 64 bits.') '') }
    if ($KD.Version.Contains('{' + '{')) { throw (New-KdError (S 'Este instalador es una plantilla sin procesar; usa el que se publica en cada versi~on.') '') }
    if ((Test-KdElevated) -and -not $Opt.ExplicitRoot) {
        # "Ejecutar como administrador" desde una cuenta sin permisos pide otra cuenta, y entonces se
        # instalaria en el perfil de esa otra cuenta, no en el de quien esta usando la PC.
        $me = [Security.Principal.WindowsIdentity]::GetCurrent().Name
        $shell = @(Get-KdShellUsers)
        Write-Log ('Instalador como administrador: ' + $me + ' | sesion: ' + ($shell -join ', '))
        if ($shell.Count -gt 0 -and -not ($shell | Where-Object { $_ -ieq $me })) {
            throw (New-KdError ((S 'Lo abriste como administrador con otra cuenta (') + $me + (S '), as~i que K-Downloader se instalar~ia para esa cuenta y no para la tuya.')) (S 'Ci~erralo y haz esto: clic derecho en el archivo > Propiedades > marca Desbloquear > Aceptar. Luego ~abrelo con doble clic, sin "Ejecutar como administrador".'))
        }
    }
    $sys32 = Join-Path $env:SystemRoot 'System32'
    $St.Curl = Join-Path $sys32 'curl.exe'
    $St.Tar = Join-Path $sys32 'tar.exe'
    $St.UseTar = Test-Path -LiteralPath $St.Tar -PathType Leaf
    if ($Opt.Local) {
        if (-not (Test-Path -LiteralPath $Opt.Local -PathType Leaf)) {
            throw (New-KdError (S 'No se encontr~o el paquete indicado con --local.') $Opt.Local)
        }
    } else {
        if (-not (Test-Path -LiteralPath $St.Curl -PathType Leaf)) {
            throw (New-KdError (S 'No se encontr~o curl.exe, que viene con Windows 10 y 11. Actualiza Windows y vuelve a intentarlo.') $St.Curl)
        }
        $St.CurlExtra = ''
        try {
            $first = (& $St.Curl --version | Select-Object -First 1)
            if ($first -match '^curl (\d+)\.(\d+)') {
                $maj = [int]$Matches[1]; $min = [int]$Matches[2]
                if ($maj -gt 7 -or ($maj -eq 7 -and $min -ge 70)) { $St.CurlExtra = ' --ssl-revoke-best-effort' }
            }
            Write-Log $first
        } catch { }
    }

    $root = $St.Root
    $driveRoot = [IO.Path]::GetPathRoot($root)
    if (-not $driveRoot -or $driveRoot.TrimEnd('\') -ieq $root) { throw (New-KdError (S 'La carpeta de instalaci~on no es v~alida.') $root) }
    if (-not $Opt.ExplicitRoot -and (Split-Path -Leaf $root) -ine 'K-Downloader') { throw (New-KdError (S 'La carpeta de instalaci~on no es v~alida.') $root) }
    if (Test-Path -LiteralPath $root) {
        if (-not (Test-Path -LiteralPath $root -PathType Container)) {
            throw (New-KdError (S 'Ya existe un archivo con el nombre de la carpeta de instalaci~on.') $root)
        }
        if (Test-Reparse $root) { throw (New-KdError (S 'La carpeta de instalaci~on es un enlace; por seguridad no se usa.') $root) }
        $hasItems = @(Get-ChildItem -LiteralPath $root -Force | Select-Object -First 1).Count -gt 0
        if ($hasItems -and -not (Test-Path -LiteralPath (Join-Path $root 'launch.pyw'))) {
            throw (New-KdError (S 'La carpeta de instalaci~on ya existe y no parece de K-Downloader; por seguridad no se toca.') $root)
        }
    }

    $size = 0L
    [void][int64]::TryParse($KD.Size, [ref]$size)
    $need = [Math]::Max($size, 30MB) * 4 + 64MB
    try { $free = (New-Object IO.DriveInfo $driveRoot).AvailableFreeSpace } catch { $free = [int64]::MaxValue }
    if ($free -lt $need) {
        throw (New-KdError ((S 'No hay espacio suficiente en el disco ') + $driveRoot + (S '. Libera al menos ') + [Math]::Ceiling($need / 1MB) + ' MB y vuelve a intentarlo.') '')
    }

    # Restos de un intento anterior que se haya cortado.
    $parent = Split-Path -Parent $root
    $leaf = Split-Path -Leaf $root
    if (Test-Path -LiteralPath $parent) {
        Get-ChildItem -LiteralPath $parent -Directory -Force -Filter ($leaf + '.staging-*') -ErrorAction SilentlyContinue |
            ForEach-Object { Remove-KdDir $_.FullName }
    }
    if (Test-Path -LiteralPath $root) {
        Get-ChildItem -LiteralPath $root -Directory -Force -Filter 'runtime.old-*' -ErrorAction SilentlyContinue |
            ForEach-Object { Remove-KdDir $_.FullName }
        $apps = Join-Path $root 'app'
        if (Test-Path -LiteralPath $apps) {
            Get-ChildItem -LiteralPath $apps -Directory -Force -Filter '*.old-*' -ErrorAction SilentlyContinue |
                ForEach-Object { Remove-KdDir $_.FullName }
        }
    }
    return $null
}

function Invoke-StepDownload {
    if ($Opt.Local) {
        $St.Zip = $Opt.Local
        $St.Downloaded = $false
        return $null
    }
    $St.TempDir = Join-Path ([IO.Path]::GetTempPath()) ('K-Downloader-' + (New-KdId))
    [void](New-Item -ItemType Directory -Path $St.TempDir -Force)
    $St.Zip = Join-Path $St.TempDir $KD.Name
    $St.Downloaded = $true
    $cl = '-L --fail --silent --show-error --retry 3 --retry-delay 2 --connect-timeout 30' + $St.CurlExtra +
        ' -o ' + (Quote $St.Zip) + ' ' + (Quote $KD.Url)
    $w = Start-KdProcess $St.Curl $cl
    $w.Progress = {
        $fi = New-Object IO.FileInfo $St.Zip
        $total = 0L
        [void][int64]::TryParse($KD.Size, [ref]$total)
        if ($fi.Exists -and $total -gt 0) { return [Math]::Min(1.0, $fi.Length / [double]$total) }
        return 0.0
    }
    $w.Detail = {
        $fi = New-Object IO.FileInfo $St.Zip
        $total = 0L
        [void][int64]::TryParse($KD.Size, [ref]$total)
        $done = 0L
        if ($fi.Exists) { $done = $fi.Length }
        return ('{0:N1} MB de {1:N1} MB' -f ($done / 1MB), ($total / 1MB))
    }
    $w.Done = {
        param($w)
        if ($w.Proc.ExitCode -ne 0) {
            throw (New-KdError (S 'No se pudo descargar K-Downloader. Revisa tu conexi~on a internet y vuelve a intentarlo.') ('curl ' + $w.Proc.ExitCode + ': ' + $w.Err.Result.Trim()))
        }
    }
    return $w
}

function Invoke-StepVerify {
    $hash = (Get-FileHash -Algorithm SHA256 -LiteralPath $St.Zip).Hash.ToLowerInvariant()
    Write-Log ('SHA-256 ' + $St.Zip + ' = ' + $hash)
    if ($hash -ne $Opt.Sha256.ToLowerInvariant()) {
        if ($St.Downloaded) { Remove-Item -LiteralPath $St.Zip -Force -ErrorAction SilentlyContinue }
        Write-Log ('SHA-256 esperado ' + $Opt.Sha256 + ', obtenido ' + $hash)
        throw (New-KdError (S 'El archivo descargado no pas~o la verificaci~on de seguridad (SHA-256): puede estar da~nado o haber sido modificado. No se instal~o nada.') ((S 'Esperado ') + $Opt.Sha256.Substring(0, 16) + (S '~., obtenido ') + $hash.Substring(0, 16) + (S '~.')))
    }
    return $null
}

function Invoke-StepClose {
    $procs = Get-KdRunning
    if ($procs.Count -eq 0) { return $null }
    if (-not (Confirm-Kd (S 'K-Downloader est~a abierto. Para continuar hay que cerrarlo y las descargas en curso se detendr~an. ~?Cerrarlo ahora?'))) {
        throw (New-KdError (S 'Instalaci~on cancelada: K-Downloader sigue abierto.') '')
    }
    Write-Log ('Cerrando ' + $procs.Count + ' proceso(s) de K-Downloader')
    $procs | Stop-Process -Force -ErrorAction SilentlyContinue
    $procs | Wait-Process -Timeout 15 -ErrorAction SilentlyContinue
    if ((Get-KdRunning).Count -gt 0) {
        throw (New-KdError (S 'No se pudo cerrar K-Downloader. Ci~erralo y vuelve a intentarlo.') '')
    }
    return $null
}

function Test-KdStaging {
    $s = $St.Staging
    $need = @('launch.pyw', 'current', 'uninstall.cmd', 'runtime\python.exe', 'runtime\pythonw.exe',
        ('app\' + $KD.Version + '\kdownloader\__init__.py'))
    foreach ($rel in $need) {
        if (-not (Test-Path -LiteralPath (Join-Path $s $rel))) {
            throw (New-KdError (S 'El paquete est~a incompleto.') ('falta ' + $rel))
        }
    }
    $cur = ([IO.File]::ReadAllText((Join-Path $s 'current'))).Trim()
    if ($cur -ne $KD.Version) { throw (New-KdError (S 'El paquete no corresponde a esta versi~on.') ('current = ' + $cur)) }
}

function Invoke-StepExtract {
    $parent = Split-Path -Parent $St.Root
    if (-not (Test-Path -LiteralPath $parent)) { [void](New-Item -ItemType Directory -Path $parent -Force) }
    $St.Staging = Join-Path $parent ((Split-Path -Leaf $St.Root) + '.staging-' + (New-KdId))
    [void](New-Item -ItemType Directory -Path $St.Staging -Force)
    if ($St.UseTar) {
        $w = Start-KdProcess $St.Tar ('-xf ' + (Quote $St.Zip) + ' -C ' + (Quote $St.Staging))
        $w.Done = {
            param($w)
            if ($w.Proc.ExitCode -ne 0) {
                throw (New-KdError (S 'No se pudo extraer el paquete.') ('tar ' + $w.Proc.ExitCode + ': ' + $w.Err.Result.Trim()))
            }
            Test-KdStaging
        }
        return $w
    }
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    try {
        [IO.Compression.ZipFile]::ExtractToDirectory($St.Zip, $St.Staging)
    } catch {
        throw (New-KdError (S 'No se pudo extraer el paquete.') $_.Exception.Message)
    }
    Test-KdStaging
    return $null
}

function Invoke-StepPlace {
    $root = $St.Root
    $stg = $St.Staging
    $ver = $KD.Version
    if (-not (Test-Path -LiteralPath $root)) {
        Move-KdDir $stg $root
        $St.Staging = $null
        return $null
    }
    $id = New-KdId

    # 1. Runtime: se renombra el actual (se recupera si algo falla) y se pone el nuevo.
    $rt = Join-Path $root 'runtime'
    $rtOld = Join-Path $root ('runtime.old-' + $id)
    if (Test-Path -LiteralPath $rt) {
        try { Move-KdDir $rt $rtOld } catch {
            throw (New-KdError (S 'La carpeta de K-Downloader est~a en uso. Cierra K-Downloader y cualquier ventana abierta en esa carpeta, y vuelve a intentarlo.') $_.Exception.Message)
        }
    }
    try {
        Move-KdDir (Join-Path $stg 'runtime') $rt
    } catch {
        $msg = $_.Exception.Message
        if (Test-Path -LiteralPath $rtOld) { try { Move-KdDir $rtOld $rt } catch { } }
        throw (New-KdError (S 'No se pudieron copiar los archivos de K-Downloader.') $msg)
    }

    # 2. Codigo de la app: app\<version> (las versiones anteriores se quedan hasta el final).
    $apps = Join-Path $root 'app'
    if (-not (Test-Path -LiteralPath $apps)) { [void](New-Item -ItemType Directory -Path $apps -Force) }
    $appDir = Join-Path $apps $ver
    $appOld = $null
    if (Test-Path -LiteralPath $appDir) {
        $appOld = $appDir + '.old-' + $id
        Move-KdDir $appDir $appOld
    }
    Move-KdDir (Join-Path $stg ('app\' + $ver)) $appDir

    # 3. El resto (launch.pyw, uninstall.cmd, icono, licencias...). "current" va al final.
    foreach ($item in @(Get-ChildItem -LiteralPath $stg -Force)) {
        $name = $item.Name
        if (@('runtime', 'app', 'current') -contains $name) { continue }
        $dest = Join-Path $root $name
        if ($item.PSIsContainer) {
            Remove-KdDir $dest
            Move-KdDir $item.FullName $dest
        } else {
            Copy-Item -LiteralPath $item.FullName -Destination $dest -Force
        }
    }
    Copy-Item -LiteralPath (Join-Path $stg 'current') -Destination (Join-Path $root 'current') -Force

    Remove-KdDir $rtOld
    if ($appOld) { Remove-KdDir $appOld }
    Remove-KdDir $stg
    $St.Staging = $null
    return $null
}

function Invoke-StepFinish {
    $py = Join-Path $St.Root 'runtime\python.exe'
    $cl = (Quote (Join-Path $St.Root 'launch.pyw')) + ' --install-finish --version ' + $KD.Version
    if ($St.Desktop) { $cl += ' --desktop' }
    if ($Opt.NoRegistry) { $cl += ' --no-registry' }
    if ($Opt.ShortcutDir) { $cl += ' --shortcut-dir ' + (Quote $Opt.ShortcutDir) }
    $w = Start-KdProcess $py $cl
    $w.Done = {
        param($w)
        $out = ($w.Out.Result + [Environment]::NewLine + $w.Err.Result).Trim()
        Write-Log ('install-finish (' + $w.Proc.ExitCode + '): ' + $out)
        if ($w.Proc.ExitCode -ne 0) {
            throw (New-KdError (S 'No se pudieron crear los accesos directos ni registrar K-Downloader en Windows.') $out)
        }
    }
    return $w
}

function Invoke-StepCleanup {
    if ($St.TempDir) { Remove-KdDir $St.TempDir; $St.TempDir = $null }
    if ($St.Staging) { Remove-KdDir $St.Staging; $St.Staging = $null }
    Write-Log ('Instalado K-Downloader ' + $KD.Version + ' en ' + $St.Root)
    return $null
}

# Peso de cada paso en la barra de progreso (la descarga pesa 0 con --local).
$Steps = @(
    @{ Text = 'Comprobando tu sistema~.'; Run = { Invoke-StepCheck }; Weight = 2 },
    @{ Text = 'Descargando K-Downloader~.'; Run = { Invoke-StepDownload }; Weight = 60 },
    @{ Text = 'Verificando el archivo~.'; Run = { Invoke-StepVerify }; Weight = 3 },
    @{ Text = 'Revisando si K-Downloader est~a abierto~.'; Run = { Invoke-StepClose }; Weight = 1 },
    @{ Text = 'Extrayendo archivos~.'; Run = { Invoke-StepExtract }; Weight = 18 },
    @{ Text = 'Copiando archivos~.'; Run = { Invoke-StepPlace }; Weight = 8; Critical = $true },
    @{ Text = 'Creando accesos directos~.'; Run = { Invoke-StepFinish }; Weight = 6; Critical = $true },
    @{ Text = 'Limpiando~.'; Run = { Invoke-StepCleanup }; Weight = 2 }
)

function Get-StepWeight([int]$Index) {
    if ($Index -eq 1 -and $Opt.Local) { return 0 }
    return $Steps[$Index].Weight
}

function Get-KdProgress {
    $total = 0.0; $done = 0.0
    for ($i = 0; $i -lt $Steps.Count; $i++) {
        $wgt = Get-StepWeight $i
        $total += $wgt
        if ($i -lt $St.Index) { $done += $wgt }
    }
    if ($St.Index -lt $Steps.Count -and $St.Waiter -and $St.Waiter.Progress) {
        $f = [double](& $St.Waiter.Progress)
        $done += (Get-StepWeight $St.Index) * [Math]::Max(0.0, [Math]::Min(1.0, $f))
    }
    if ($total -le 0) { return 1.0 }
    return $done / $total
}

function Get-KdFailure($ErrorRecord) {
    $ex = $ErrorRecord.Exception
    while ($ex -and -not $ex.Data.Contains('kd') -and $ex.InnerException) { $ex = $ex.InnerException }
    if ($ex -and $ex.Data.Contains('kd')) {
        return @{ Message = $ex.Message; Detail = [string]$ex.Data['detail'] }
    }
    return @{ Message = (S 'Algo sali~o mal durante la instalaci~on.'); Detail = $ErrorRecord.Exception.Message }
}

# --- Modo consola (--console) y silencioso (--quiet) ------------------------------------------

function Invoke-KdConsole {
    $quiet = $Opt.Mode -eq 'quiet'
    if ($null -ne $Opt.Desktop) { $St.Desktop = [bool]$Opt.Desktop }
    elseif ($quiet) { $St.Desktop = $false }
    else { $St.Desktop = (-not $St.Existing) -or (Test-Path -LiteralPath (Get-DesktopLink)) }
    Write-Host ''
    Write-Host ((S 'Instalador de K-Downloader ') + $KD.Version)
    Write-Host ((S 'Carpeta: ') + $St.Root)
    Write-Log ('--- Instalador ' + $KD.Version + ' (' + $Opt.Mode + ') en ' + $St.Root + ' args: ' + $env:KD_ARGS)
    try {
        for ($i = 0; $i -lt $Steps.Count; $i++) {
            $St.Index = $i
            $step = $Steps[$i]
            Write-Host ('[{0}/{1}] {2}' -f ($i + 1), $Steps.Count, (S $step.Text))
            $w = & $step.Run
            if ($w) {
                $St.Waiter = $w
                $lastPct = -1
                while (-not $w.Proc.HasExited) {
                    Start-Sleep -Milliseconds 200
                    if ($w.Progress) {
                        $pct = [int][Math]::Floor(100 * [double](& $w.Progress) / 10) * 10
                        if ($pct -ne $lastPct -and $pct -gt 0) { Write-Host ('      ' + $pct + ' %'); $lastPct = $pct }
                    }
                }
                $w.Proc.WaitForExit()
                $St.Waiter = $null
                if ($w.Done) { $null = & $w.Done $w }
            }
        }
    } catch {
        $fail = Get-KdFailure $_
        Write-Log ('ERROR: ' + $fail.Message + ' | ' + $fail.Detail + ' | ' + $_.ScriptStackTrace)
        Clear-KdTemp
        Write-Host ''
        Write-Host ('ERROR: ' + $fail.Message)
        if ($fail.Detail) { Write-Host ('  ' + $fail.Detail) }
        Write-Host ((S 'Registro: ') + $LogFile)
        return 1
    }
    Write-Host ''
    Write-Host ((S '~!Listo! K-Downloader ') + $KD.Version + (S ' est~a instalado en ') + $St.Root)
    $launch = $Opt.Launch
    if ($null -eq $launch) { $launch = -not $quiet }
    if ($launch) { Start-KdApp }
    return 0
}

# --- Ventana ----------------------------------------------------------------------------------

$Ui = @{}

function New-KdColor([int]$R, [int]$G, [int]$B) { return [System.Drawing.Color]::FromArgb(255, $R, $G, $B) }

function New-RoundPath([single]$X, [single]$Y, [single]$W, [single]$H, [single]$R) {
    $p = New-Object System.Drawing.Drawing2D.GraphicsPath
    $d = [Math]::Min($R * 2, [Math]::Min($W, $H))
    if ($d -le 1) {
        $p.AddRectangle((New-Object System.Drawing.RectangleF $X, $Y, $W, $H))
        return $p
    }
    $p.AddArc($X, $Y, $d, $d, 180, 90)
    $p.AddArc($X + $W - $d, $Y, $d, $d, 270, 90)
    $p.AddArc($X + $W - $d, $Y + $H - $d, $d, $d, 0, 90)
    $p.AddArc($X, $Y + $H - $d, $d, $d, 90, 90)
    $p.CloseFigure()
    return $p
}

function ConvertTo-KdPoints([int[]]$Coords, [single]$X, [single]$Y, [single]$K) {
    $pts = New-Object 'System.Drawing.PointF[]' ($Coords.Length / 2)
    for ($i = 0; $i -lt $pts.Length; $i++) {
        $pts[$i] = New-Object System.Drawing.PointF ($X + $Coords[2 * $i] * $K), ($Y + $Coords[2 * $i + 1] * $K)
    }
    return , $pts
}

function New-KdGradient([single]$X1, [single]$Y1, [single]$X2, [single]$Y2) {
    $b = New-Object System.Drawing.Drawing2D.LinearGradientBrush (New-Object System.Drawing.PointF $X1, $Y1), (New-Object System.Drawing.PointF $X2, $Y2), $Ui.C1, $Ui.C3
    $blend = New-Object System.Drawing.Drawing2D.ColorBlend 3
    $blend.Colors = [System.Drawing.Color[]]@($Ui.C1, $Ui.C2, $Ui.C3)
    $blend.Positions = [single[]]@(0.0, 0.55, 1.0)
    $b.InterpolationColors = $blend
    $b.WrapMode = [System.Drawing.Drawing2D.WrapMode]::TileFlipXY
    return $b
}

function Draw-KdLogo($G, [single]$X, [single]$Y, [single]$Size) {
    # Misma geometria que packaging/assets/logo.svg (viewBox 256).
    $k = $Size / 256.0
    $G.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
    $rx = $X + 8 * $k; $ry = $Y + 8 * $k; $rs = 240 * $k
    $path = New-RoundPath $rx $ry $rs $rs (56 * $k)
    $brush = New-KdGradient $rx $ry ($rx + $rs) ($ry + $rs)
    $G.FillPath($brush, $path)
    $brush.Dispose(); $path.Dispose()
    $white = [System.Drawing.Brushes]::White
    $G.FillPolygon($white, (ConvertTo-KdPoints @(68, 52, 102, 52, 102, 112, 154, 52, 196, 52, 136, 118, 170, 157, 126, 157, 102, 129, 102, 192, 68, 192) $X $Y $k))
    $G.FillEllipse($white, ($X + 132 * $k), ($Y + 132 * $k), (92 * $k), (92 * $k))
    $indigo = New-Object System.Drawing.SolidBrush $Ui.C1
    $G.FillPolygon($indigo, (ConvertTo-KdPoints @(168, 150, 188, 150, 188, 178, 204, 178, 178, 206, 152, 178, 168, 178) $X $Y $k))
    $indigo.Dispose()
}

function New-KdButton([string]$Text, [int]$X, [int]$Y, [int]$W, [bool]$Primary) {
    $b = New-Object System.Windows.Forms.Button
    $b.Text = $Text
    $b.SetBounds($X, $Y, $W, 36)
    $b.FlatStyle = [System.Windows.Forms.FlatStyle]::Flat
    $b.FlatAppearance.BorderSize = 0
    $b.UseVisualStyleBackColor = $false
    $b.Cursor = [System.Windows.Forms.Cursors]::Hand
    if ($Primary) {
        $b.BackColor = $Ui.C1
        $b.ForeColor = [System.Drawing.Color]::White
        $b.FlatAppearance.MouseOverBackColor = New-KdColor 0x55 0x58 0xE6
        $b.FlatAppearance.MouseDownBackColor = New-KdColor 0x48 0x4B 0xD6
        $b.Font = $Ui.FontBold
    } else {
        $b.BackColor = New-KdColor 0xEE 0xEF 0xF5
        $b.ForeColor = $Ui.Text
        $b.FlatAppearance.MouseOverBackColor = New-KdColor 0xE2 0xE4 0xEE
        $b.FlatAppearance.MouseDownBackColor = New-KdColor 0xD6 0xD9 0xE6
    }
    return $b
}

function Set-KdStatus([string]$Text, [string]$Detail, [bool]$IsError) {
    $Ui.Status.Text = $Text
    if ($IsError) { $Ui.Status.ForeColor = $Ui.Red } else { $Ui.Status.ForeColor = $Ui.Text }
    if ($null -ne $Detail) { $Ui.Detail.Text = $Detail }
    # El estado puede ocupar varias lineas (errores): el detalle se acomoda debajo.
    $measured = [System.Windows.Forms.TextRenderer]::MeasureText($Text, $Ui.Status.Font,
        (New-Object System.Drawing.Size $Ui.Status.Width, 0), [System.Windows.Forms.TextFormatFlags]::WordBreak)
    $h = [Math]::Max(22, [Math]::Min(64, $measured.Height + 2))
    $Ui.Status.Height = $h
    $Ui.Detail.Top = $Ui.Status.Top + $h + 2
    $Ui.Detail.Height = [Math]::Max(18, 346 - $Ui.Detail.Top)
}

function Set-KdUiState([string]$State) {
    $St.Ui = $State
    $f = $Ui
    switch ($State) {
        'ready' {
            $f.Primary.Text = $f.StartText; $f.Primary.Enabled = $true
            $f.Secondary.Text = 'Cancelar'; $f.Secondary.Enabled = $true
            $f.Desktop.Enabled = $true; $f.Bar.Visible = $false; $f.LogLink.Visible = $false
        }
        'running' {
            $f.Primary.Text = (S 'Instalando~.'); $f.Primary.Enabled = $false
            $f.Secondary.Text = 'Cancelar'; $f.Secondary.Enabled = -not $St.Critical
            $f.Desktop.Enabled = $false; $f.Bar.Visible = $true; $f.LogLink.Visible = $false
        }
        'done' {
            $f.Primary.Text = 'Abrir K-Downloader'; $f.Primary.Enabled = $true
            $f.Secondary.Text = 'Cerrar'; $f.Secondary.Enabled = $true
            $f.Desktop.Enabled = $false; $f.LogLink.Visible = $false
            [void]$f.Primary.Focus()
        }
        'error' {
            $f.Primary.Text = 'Reintentar'; $f.Primary.Enabled = $true
            $f.Secondary.Text = 'Cerrar'; $f.Secondary.Enabled = $true
            $f.Desktop.Enabled = $true; $f.LogLink.Visible = $true
        }
    }
}

function Start-KdInstall {
    $St.Index = 0
    $St.Waiter = $null
    $St.Critical = $false
    $St.Progress = 0.0
    $St.Desktop = $Ui.Desktop.Checked
    Write-Log ('--- Instalador ' + $KD.Version + ' (ventana) en ' + $St.Root + ' args: ' + $env:KD_ARGS)
    Set-KdStatus (S $Steps[0].Text) '' $false
    Set-KdUiState 'running'
    $Ui.Timer.Start()
}

function Show-KdDone {
    $Ui.Timer.Stop()
    $St.Busy = $false
    $St.Progress = 1.0
    $St.ExitCode = 0
    $where = S 'Lo encontrar~as en el men~u Inicio'
    if ($St.Desktop -and -not $Opt.NoRegistry) { $where += (S ' y en el escritorio') }
    Set-KdStatus (S '~!Listo! K-Downloader est~a instalado.') ($where + '.') $false
    Set-KdUiState 'done'
    $Ui.Bar.Invalidate()
}

function Show-KdFailure($ErrorRecord) {
    $Ui.Timer.Stop()
    $St.Busy = $false
    $fail = Get-KdFailure $ErrorRecord
    Write-Log ('ERROR: ' + $fail.Message + ' | ' + $fail.Detail + ' | ' + $ErrorRecord.ScriptStackTrace)
    Clear-KdTemp
    $detail = $fail.Detail
    if ($detail -and $detail.Length -gt 240) { $detail = $detail.Substring(0, 240) + (S '~.') }
    Set-KdStatus $fail.Message $detail $true
    Set-KdUiState 'error'
    $Ui.Bar.Invalidate()
}

function Invoke-KdTick {
    $St.Tick++
    if ($St.Waiter) {
        $w = $St.Waiter
        if (-not $w.Proc.HasExited) {
            $St.Busy = -not $w.Progress
            $St.Progress = Get-KdProgress
            if ($w.Detail) { $Ui.Detail.Text = [string](& $w.Detail) }
            $Ui.Bar.Invalidate()
            return
        }
        $w.Proc.WaitForExit()
        $St.Waiter = $null
        if ($w.Done) { $null = & $w.Done $w }
        $St.Index++
        $St.Progress = Get-KdProgress
        $Ui.Bar.Invalidate()
        return
    }
    if ($St.Index -ge $Steps.Count) { Show-KdDone; return }
    $step = $Steps[$St.Index]
    $St.Critical = [bool]$step.Critical
    $St.Busy = $true
    Set-KdStatus (S $step.Text) '' $false
    Set-KdUiState 'running'
    $Ui.Form.Refresh()
    $w = & $step.Run
    if ($w) { $St.Waiter = $w } else { $St.Index++ }
    $St.Progress = Get-KdProgress
    $Ui.Bar.Invalidate()
}

function Show-KdWindow {
    [System.Windows.Forms.Application]::EnableVisualStyles()
    $Ui.C1 = New-KdColor 0x63 0x66 0xF1
    $Ui.C2 = New-KdColor 0x8B 0x5C 0xF6
    $Ui.C3 = New-KdColor 0xF9 0x73 0x62
    $Ui.Dark = New-KdColor 0x10 0x12 0x18
    $Ui.Text = New-KdColor 0x1F 0x23 0x30
    $Ui.Muted = New-KdColor 0x6B 0x70 0x85
    $Ui.Red = New-KdColor 0xC0 0x36 0x3A
    $Ui.Track = New-KdColor 0xE6 0xE7 0xF0
    $Ui.Font = New-Object System.Drawing.Font 'Segoe UI', 10
    $Ui.FontSmall = New-Object System.Drawing.Font 'Segoe UI', 9
    $Ui.FontBold = New-Object System.Drawing.Font 'Segoe UI Semibold', 10
