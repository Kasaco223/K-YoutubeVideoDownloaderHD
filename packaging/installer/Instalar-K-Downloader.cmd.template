    $Ui.FontSub = New-Object System.Drawing.Font 'Segoe UI', 9.5

    $form = New-Object System.Windows.Forms.Form
    $Ui.Form = $form
    $form.Text = S 'Instalar K-Downloader'
    $form.ClientSize = New-Object System.Drawing.Size 540, 400
